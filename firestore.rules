rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction utilitaire pour vérifier si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Fonction utilitaire pour vérifier si l'utilisateur est le propriétaire de la ressource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fonction pour vérifier si l'utilisateur est administrateur
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Validation minimale côté serveur des profils (cahier des charges § 5.3).
    function validProfile() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 160
        && request.resource.data.email.matches('.+@.+\\..+');
    }

    // --- COLLECTION USERS (Profils Utilisateurs) ---
    // Lecture : l'utilisateur lui-même ou les administrateurs
    // Écriture : l'utilisateur lui-même uniquement (création & mise à jour)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId) && validProfile();
      allow delete: if isAdmin();
    }

    // --- COLLECTION STORIES (Contes, Fables, Proverbes, Coutumes) ---
    // Lecture : publique (ouvrable à tous les membres et visiteurs)
    // Écriture : réservée aux administrateurs ou griots certifiés
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0;
      allow update, delete: if isAdmin();
    }

    // --- COLLECTION FAVORITES ---
    // Lecture & Écriture : chaque utilisateur ne peut gérer QUE ses propres favoris.
    // L'identifiant du document doit rester « {userId}_{storyId} ».
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.storyId is string
        && favoriteId == request.resource.data.userId + '_' + request.resource.data.storyId;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // --- COLLECTION PRODUCTS (Artisanat & Marketplace) ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- COLLECTION LANGUAGES & COURSES ---
    match /languages/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
