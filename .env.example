# Configuration Firebase — copier ce fichier vers .env
# Console Firebase > Paramètres du projet > Vos applications > Configuration SDK

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth Google — Google Cloud Console > Identifiants > ID client OAuth
# Les client IDs sont publics ; ne jamais placer de secret ici.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# OAuth Facebook — developers.facebook.com > Paramètres > Identifiant de l'application
# L'App Secret se configure uniquement dans la console Firebase.
EXPO_PUBLIC_FACEBOOK_APP_ID=

# DjeliBot (IA) — Google AI Studio > Get API key
# IMPORTANT : pas de préfixe EXPO_PUBLIC_ sur la clé, elle doit rester côté serveur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# URL de l'API DjeliBot pour les builds natifs (Android/iOS).
# Sur le web, l'app appelle /api/chat sur la même origine : laisser vide.
EXPO_PUBLIC_AI_API_URL=
