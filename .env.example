# Configuration Firebase — copier ce fichier vers .env
# Console Firebase > Paramètres du projet > Vos applications > Configuration SDK

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# OAuth Google — Google Cloud Console > Identifiants > ID client OAuth
# Les client IDs sont publics ; ne jamais placer de secret ici.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# OAuth Facebook — developers.facebook.com > Paramètres > Identifiant de l'application
# L'App Secret se configure uniquement dans la console Firebase.
EXPO_PUBLIC_FACEBOOK_APP_ID=
