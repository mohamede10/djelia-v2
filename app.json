
{
  "expo": {
    "name": "Djelia",
    "slug": "djelia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "djelia",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.djelia.app"
    },
    "android": {
      "package": "com.djelia.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDFBF7",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#1B263B"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Djelia accède à vos photos uniquement pour personnaliser votre profil.",
          "cameraPermission": "Djelia utilise l’appareil photo uniquement pour votre photo de profil."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
